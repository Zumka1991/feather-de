<?xml version="1.0"?>
<labwc_config>
  <core>
    <decoration>client</decoration>
    <gap>0</gap>
  </core>
  <keyboard>
    <numlock>on</numlock>
    <keybind key="C-A-BackSpace">
      <action name="Exit" />
    </keybind>
  </keyboard>
  <windowRules>
    <windowRule identifier="*" serverDecoration="no">
      <action name="Maximize" />
    </windowRule>
  </windowRules>
</labwc_config>
