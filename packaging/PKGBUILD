# Maintainer: Feather DE Team <feather@local>
pkgname=feather-de
# Версия берётся из корневого Cargo.toml: PKGBUILD собирает текущее дерево исходников
pkgver="$(sed -n 's/^version = "\(.*\)"$/\1/p' "${startdir:-$PWD}/../Cargo.toml" 2>/dev/null | head -n 1)"
pkgver="${pkgver:-0.0.0}"
pkgrel=1
pkgdesc="Пёрышко (Feather DE) — сверхбыстрое окружение рабочего стола Wayland в стиле macOS Tahoe на Rust"
arch=('x86_64' 'aarch64')
url="https://github.com/Zumka1991/feather-de"
# Лицензия проекта ещё не выбрана автором; не объявляем MIT без LICENSE.
license=()
depends=(
    'glibc'
    'gcc-libs'
    'libinput'
    'libdrm'
    'libxkbcommon'
    'seatd'
    'mesa'
    'pam'
    'systemd-libs'
    'wayland'
    'libglvnd'
    'fontconfig'
    'noto-fonts'
    'dbus'
    'libpipewire'
    'xwayland-satellite'
)
optdepends=(
    'noto-fonts-emoji: значки панели эмодзи и эмодзи в программах'
    'labwc: запуск в режиме совместимости (nested/kiosk)'
    'xdg-desktop-portal: системные диалоги выбора файлов и захвата экрана'
    'pipewire: управление звуком в Центре управления'
    'libpulse: pactl для управления звуком'
    'pipewire-pulse: сервер совместимости PulseAudio'
    'networkmanager: управление Wi-Fi в Центре управления и Настройках'
    'bluez: управление Bluetooth в Центре управления и Настройках'
    'greetd: экран входа Пёрышка (--login)'
    'poppler: pdftoppm для полного рендеринга PDF в Просмотре'
    'unarchiver: ARJ, ACE, одиночный .gz, зашифрованный 7z в Файлах (RAR Файлы читают сами)'
)
makedepends=('cargo' 'pkgconf' 'clang')
options=('!debug' '!lto')
backup=(
    'etc/pam.d/feather-lock'
    'etc/greetd/feather-greeter.toml'
)
install=feather-de.install
source=()
sha256sums=()

build() {
    cd "$startdir/.."
    CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$srcdir/target}" cargo build --release --locked --workspace
}

check() {
    cd "$startdir/.."
    CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$srcdir/target}" cargo test --release --locked --bin feather-de first_run
}

package() {
    cd "$startdir/.."
    DESTDIR="$pkgdir" PREFIX="/usr" SYSCONFDIR="/etc" \
        ./packaging/install.sh --no-build --target-dir "${CARGO_TARGET_DIR:-$srcdir/target}/release"
}
