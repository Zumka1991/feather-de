[Desktop Entry]
Name=Package Installer
Name[ru]=Установка программ
Name[es]=Instalador de paquetes
Name[de]=Paketinstallation
Name[fr]=Installateur de paquets
Name[zh_CN]=软件包安装器
Comment=Install apps from .deb packages
Comment[ru]=Установка программ из пакетов .deb
Exec=feather-installer %f
Icon=system-software-install
Terminal=false
Type=Application
NoDisplay=true
MimeType=application/vnd.debian.binary-package;application/x-deb;
Categories=System;PackageManager;
StartupWMClass=feather-installer
